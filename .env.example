# ── Database ──────────────────────────────────────────
# PostgreSQL is available under the "infra" compose profile.
# Default (no DATABASE_URL) uses SQLite at backend/data/paperforge.db.
# DATABASE_URL=postgresql://paperforge:paperforge@postgres:5432/paperforge
POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=paperforge

# ── Object Storage (infra profile) ────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456

# ── LLM Provider ──────────────────────────────────────
# Configure via the /api/llm-config endpoint at runtime.
# Provider examples: openai, deepseek, kimi, zhipu, qwen, local
# No env vars needed — all stored in DB (llm_configs table).

# ── Outbound Proxy (optional) ─────────────────────────
# For backend search/download when running behind a proxy.
# Use host.docker.internal instead of 127.0.0.1 inside Docker.
# PAPERFORGE_PROXY_URL=http://host.docker.internal:7890
# PAPERFORGE_PROXY_HOST=host.docker.internal
# PAPERFORGE_USE_SYSTEM_PROXY=false
# PAPERFORGE_HTTPS_PROXY=
# PAPERFORGE_HTTP_PROXY=

# ── Qdrant Vector DB ──────────────────────────────────
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=paper_chunks
# QDRANT_VECTOR_SIZE=384

# ── GROBID PDF Parser ─────────────────────────────────
# GROBID_URL=http://localhost:8070
# GROBID_TIMEOUT=120

# ── Security ──────────────────────────────────────────
# PAPERFORGE_MAX_UPLOAD_SIZE_MB=50
# PAPERFORGE_ALLOW_TLS_DOWNGRADE=false

# ── Dev / Debug ───────────────────────────────────────
# PAPERFORGE_AUTO_CREATE_TABLES=false
