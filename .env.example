POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=paperforge

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456

# Optional: outbound proxy for backend search/download.
# If your host proxy listens on 127.0.0.1:7890, do NOT use 127.0.0.1 in Docker;
# use host.docker.internal:7890 instead.
# PAPERFORGE_PROXY_URL=http://host.docker.internal:7890
# PAPERFORGE_PROXY_HOST=host.docker.internal
# PAPERFORGE_USE_SYSTEM_PROXY=false
